{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mobile.tsbuildinfo",
    "target": "es2023",
    /* No DOM, deliberately: src/mobile is the phone app's PURE core. If something in here
       needs `document` or `window`, it is in the wrong directory, and src/mobile/seal.test.ts
       says the same thing about react-native and expo imports. */
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true
  },
  "include": ["src/mobile"]
}
